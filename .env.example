# ========== Postgres 連線字串 ==========
# 建議用 Supabase Transaction pooler（支援 IPv4、繞過 server-side prepared statement 限制）
# 範例格式：postgresql://postgres.[project-ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# 從 Supabase Dashboard > Project Settings > Database > Connection string > Transaction mode 複製
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# ========== NextAuth 5 / Auth.js v5 ==========
# 必填，32 字元以上隨機字串
# 用 `openssl rand -base64 32` 生成
AUTH_SECRET=請用-`openssl-rand-base64-32`-生成-32-字元以上隨機字串

# 部分部署環境（Vercel）需要 NEXTAUTH_SECRET 與 AUTH_SECRET 同值
# 詳見 https://authjs.dev/getting-started/deployment
NEXTAUTH_SECRET=同-AUTH_SECRET-即可

# ========== App 對外網址 ==========
# 本地開發用 http://localhost:3000
# 部署到 Vercel 要改成實際網址（會影響 OAuth callback 與 Stripe redirect）
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ========== Stripe（test mode）==========
# 從 https://dashboard.stripe.com/test/apikeys 取得 Secret key
STRIPE_SECRET_KEY=sk_test_xxx

# Webhook signing secret，本地開發用：
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
# 然後把 `whsec_xxx` 貼到這裡
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Pro 方案 NT$499/月 的 price id
# 從 https://dashboard.stripe.com/test/products 對應 Product 的 Pricing 區取得
STRIPE_PRICE_PRO=price_xxx_pro

# Business 方案 NT$1,499/月 的 price id
STRIPE_PRICE_BUSINESS=price_xxx_business
